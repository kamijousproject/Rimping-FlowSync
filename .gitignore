# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploaded files
/uploads/

# editor
.vscode/
.idea/

# os
Thumbs.db

# Google Service Account credentials (sensitive — never commit)
*.json
!package.json
!package-lock.json
!tsconfig.json
!jsconfig.json

# TestSprite - Test artifacts and temporary files
testsprite_tests/
.testsprite/
*.testsprite.json
testsprite-mcp-test-report.md
testsprite_*.log
testsprite_cache/

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
.venv/
venv/

# Backend runtime
backend/backend.log
backend/__pycache__/
src/backend/__pycache__/
